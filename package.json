{
  "name": "medlearn",
  "version": "2.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.js tests/*.test.ts",
    "validate:cases": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/validate-case-library.mjs",
    "generate:case-seeds": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-alpha-case-seeds.mjs",
    "validate:state": "python scripts/validate_project_state.py",
    "verify:remote": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/verify-remote-supabase.mjs",
    "audit:remote": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/audit-remote-schema.mjs",
    "preflight:deploy": "powershell -ExecutionPolicy Bypass -File scripts/preflight-deploy.ps1",
    "build:remote-bootstrap": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-remote-bootstrap.mjs",
    "apply:remote-sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/apply-remote-via-db.mjs",
    "deploy:remote": "powershell -ExecutionPolicy Bypass -File scripts/deploy-remote-supabase.ps1",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.17.0",
    "expo": "~56.0.11",
    "expo-asset": "~56.0.17",
    "expo-constants": "~56.0.18",
    "expo-font": "~56.0.6",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.10",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~56.0.4",
    "pg": "^8.16.3",
    "typescript": "~6.0.3"
  }
}
