{
  "name": "medlearn",
  "version": "2.0.0",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22 <25"
  },
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clean": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "npx eas-cli@latest build --platform android",
    "build:android:preview": "npx eas-cli@latest build --platform android --profile preview",
    "build:android:preview:local": "npx eas-cli@latest build --platform android --profile preview --local --output=artifacts/medlearn-preview.apk",
    "build:android:qa": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-local.ps1 -Mode qa",
    "build:android:qa:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-local.ps1 -Mode qa -Clean",
    "build:android:qa:prebuild": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-local.ps1 -Mode qa -RegenerateNative",
    "build:android:qa:verified": "npm run verify:android:qa && npm run build:android:qa",
    "build:android:local-release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-local.ps1 -Mode release",
    "build:android:local-release:verified": "npm run check && npm run build:android:local-release",
    "build:android:local-arm64": "npm run build:android:qa",
    "build:ios": "npx eas-cli@latest build --platform ios",
    "typecheck": "node --max-old-space-size=8192 node_modules/typescript/bin/tsc --noEmit",
    "lint": "expo lint",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=2 tests/*.test.js tests/*.test.ts",
    "test:python": ".\\.venv-sft\\Scripts\\python.exe -m unittest discover -s tests -p test_*.py",
    "check:full": "npm run check && npm run test:python",
    "measure:wrong-question": "node scripts/measure-wrong-question-lookup.mjs --pretty --require-match --max-ms=15000",
    "walkthrough:wrong-question-ui": "node scripts/run-wrong-question-ui-walkthrough.mjs --case=rq-resp-001",
    "walkthrough:wrong-question-review-queue": "node scripts/run-wrong-question-review-queue-walkthrough.mjs --case=rq-resp-003 --variant=stem_options_only",
    "check:version": "node scripts/check-project-version.mjs",
    "check:routes": "node scripts/check-route-contract.mjs",
    "validate:cases": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/validate-case-library.mjs",
    "generate:case-seeds": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-alpha-case-seeds.mjs",
    "validate:state": ".\\.venv-sft\\Scripts\\python.exe scripts\\validate_project_state.py",
    "verify:remote": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/verify-remote-supabase.mjs",
    "audit:remote": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/audit-remote-schema.mjs",
    "preflight:deploy": "powershell -ExecutionPolicy Bypass -File scripts/preflight-deploy.ps1",
    "build:remote-bootstrap": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-remote-bootstrap.mjs",
    "apply:remote-sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/apply-remote-via-db.mjs",
    "apply:remote-api": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/apply-remote-via-api.mjs",
    "seed:remote-cases": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/seed-remote-cases.mjs",
    "configure:remote-secrets": "powershell -ExecutionPolicy Bypass -File scripts/configure-remote-secrets.ps1",
    "e2e:remote": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/run-remote-e2e.mjs",
    "deploy:remote": "powershell -ExecutionPolicy Bypass -File scripts/deploy-remote-supabase.ps1",
    "test:pipeline": ".\\.venv-sft\\Scripts\\python.exe -m unittest discover -s tests -p test_*.py",
    "check": "npm run check:version && npm run check:routes && npm run typecheck && npm run lint && npm test",
    "verify:android:qa": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-android-qa.ps1",
    "clean:android:artifacts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-android-artifacts.ps1",
    "clean:android:artifacts:apply": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-android-artifacts.ps1 -Apply",
    "docs:dev": "vitepress dev site",
    "docs:build": "vitepress build site",
    "docs:preview": "vitepress preview site",
    "docs:obsidian": "powershell -ExecutionPolicy Bypass -File scripts/setup-obsidian-links.ps1 && node scripts/generate-obsidian-doc-nav.mjs",
    "docs:obsidian:nav": "node scripts/generate-obsidian-doc-nav.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.17.0",
    "expo": "~56.0.11",
    "expo-asset": "~56.0.17",
    "expo-constants": "~56.0.18",
    "expo-font": "~56.0.6",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.10",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~56.0.4",
    "pg": "^8.16.3",
    "typescript": "~6.0.3",
    "vitepress": "^1.6.4"
  }
}
