# Supabase 配置
# 从 Supabase 控制台获取：https://supabase.com/dashboard
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 脚本专用配置（ingest_with_tree.py 需要 Service Role Key）
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Supabase CLI 部署（https://supabase.com/dashboard/account/tokens）
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here

# 可选：直连数据库执行 bootstrap SQL（Settings -> Database -> Connection string）
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# AI API 配置
# Server-side only - do not use EXPO_PUBLIC_ prefix
AI_API_KEY=your_deepseek_api_key_here
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_INPUT_COST_PER_MILLION=0.14
AI_OUTPUT_COST_PER_MILLION=0.28
CASE_MAX_TOKENS=15000
CASE_MAX_COST_USD=0.60
AI_PROXY_WINDOW_MINUTES=60
AI_PROXY_MAX_REQUESTS=60
AI_PROXY_MAX_TOKENS=100000

# 向量生成服务（SiliconFlow BGE-M3）
# Server-side only - do not use EXPO_PUBLIC_ prefix
SILICONFLOW_KEY=your_siliconflow_key_here

# 向量模型路径（可选，默认使用 HuggingFace 模型名）
MODEL_PATH=BAAI/bge-large-zh-v1.5
USE_LOCAL_MODEL=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=bge-m3
EXPO_PUBLIC_EMBEDDING_PROVIDER=ollama
EXPO_PUBLIC_OLLAMA_URL=http://127.0.0.1:11434
EXPO_PUBLIC_OLLAMA_EMBED_MODEL=bge-m3

## Supabase Edge Functions Environment
# AI_API_KEY - AI 服务 API 密钥（服务端专用）
# SILICONFLOW_KEY - SiliconFlow 向量服务密钥（服务端专用）
# AI_BASE_URL - DeepSeek OpenAI 兼容地址（默认 https://api.deepseek.com/v1）
# AI_MODEL - DeepSeek 模型（默认 deepseek-chat；推理可用 deepseek-reasoner）
