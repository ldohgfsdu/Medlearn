# Supabase 配置
# 从 Supabase 控制台获取：https://supabase.com/dashboard
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 脚本专用配置（ingest_with_tree.py 需要 Service Role Key）
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Supabase CLI 部署（https://supabase.com/dashboard/account/tokens）
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here

# Demo 医学审核账号（仅 seed-remote-cases.mjs 本地/测试环境使用）
# DEMO_REVIEWER_PASSWORD=change_me_before_remote_seed

# 可选：直连数据库执行 bootstrap SQL（Settings -> Database -> Connection string）
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# AI API 配置
# Server-side only - do not use EXPO_PUBLIC_ prefix
AI_API_KEY=your_deepseek_api_key_here
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-v4-pro
AI_INPUT_COST_PER_MILLION=0.435
AI_OUTPUT_COST_PER_MILLION=0.87
CASE_MAX_TOKENS=15000
CASE_MAX_COST_USD=0.60
AI_PROXY_WINDOW_MINUTES=60
AI_PROXY_MAX_REQUESTS=60
AI_PROXY_MAX_TOKENS=100000

# 本地 Embedding（推荐：Ollama bge-m3，1024 维）
EXPO_PUBLIC_EMBEDDING_PROVIDER=ollama
EXPO_PUBLIC_OLLAMA_URL=http://127.0.0.1:11434
EXPO_PUBLIC_OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EXE=F:\Ollama\ollama.exe
OLLAMA_MODELS=F:\ml\.ollama\models
OLLAMA_MODEL=medlearn-qwen3:8b
# Ollama 抽取并发数（默认 1 串行，设 2/3 开启并发）
OLLAMA_CONCURRENCY=1
# Ollama 抽取最大生成 token 数（默认 1024）
OLLAMA_NUM_PREDICT=1024
HF_HOME=F:\ml\.models\huggingface
HF_HUB_CACHE=F:\ml\.models\huggingface\hub
MEDLEARN_TRAINING_DIR=F:\ml\training
USE_LOCAL_MODEL=true
MODEL_PATH=BAAI/bge-m3

# 远端 embedding 代理（仅当客户端无法直连 Ollama 时使用 SiliconFlow）
# SILICONFLOW_KEY=your_siliconflow_key_here

## Supabase Edge Functions Environment
# AI_API_KEY - AI 服务 API 密钥（服务端专用）
# SILICONFLOW_KEY - SiliconFlow 向量服务密钥（服务端专用）
# AI_BASE_URL - DeepSeek OpenAI 兼容地址（默认 https://api.deepseek.com/v1）
# AI_MODEL - DeepSeek 模型（默认 deepseek-chat；推理可用 deepseek-reasoner）
