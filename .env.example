# Supabase 配置
# 从 Supabase 控制台获取：https://supabase.com/dashboard
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 脚本专用配置（ingest_with_tree.py 需要 Service Role Key）
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# AI API 配置
EXPO_PUBLIC_AI_API_KEY=your_ai_api_key_here
EXPO_PUBLIC_AI_API_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
EXPO_PUBLIC_AI_MODEL=mimo-v2.5-pro

# 向量生成服务（SiliconFlow BGE-M3）
EXPO_PUBLIC_SILICONFLOW_KEY=your_siliconflow_key_here

# 向量模型路径（可选，默认使用 HuggingFace 模型名）
MODEL_PATH=iic/nlp_gte_sentence-embedding_chinese-base
