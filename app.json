{
  "expo": {
    "name": "Medlearn",
    "slug": "medlearn",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "medlearn",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#17332C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medlearn.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#17332C"
      },
      "package": "com.medlearn.app"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "title": "Medlearn",
      "favicon": "./assets/icon.png"
    }
  }
}
