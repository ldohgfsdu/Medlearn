[
  {
    "id": "golden_disease_cap_001",
    "title": "社区获得性肺炎",
    "type": "disease",
    "aliases": ["CAP", "Community Acquired Pneumonia"],
    "source_chunk": {
      "raw_text": "社区获得性肺炎是医院外获得的肺炎感染，包括在社区中发生的肺炎。临床表现主要为发热、咳嗽、咳痰（部分患者咳铁锈色痰）、胸痛、呼吸困难。体征可有肺实变体征（叩诊浊音、语颤增强、支气管呼吸音）。实验室检查可见白细胞升高、中性粒细胞比例增加。胸部X线检查可见肺部浸润影。诊断标准包括：①症状和体征；②影像学证据（胸片或CT显示浸润影）；③实验室证据（白细胞升高）。治疗以经验性抗生素为主，常用β-内酰胺类联合大环内酯类。",
      "source": {
        "book": "内科学",
        "edition": "第10版",
        "page": 45,
        "chapter": "呼吸系统疾病"
      }
    },
    "expected_content": {
      "definition": "医院外获得的肺炎感染",
      "clinical_manifestations": "发热、咳嗽、咳铁锈色痰、胸痛、呼吸困难、肺实变体征",
      "diagnostic_criteria": "症状和体征 + 影像学证据（胸片或CT显示浸润影） + 实验室证据（白细胞升高）",
      "treatment_principles": "经验性抗生素为主，β-内酰胺类联合大环内酯类"
    },
    "expected_relations": [
      {"target_name": "呼吸衰竭", "relation_type": "complication"},
      {"target_name": "肺脓肿", "relation_type": "complication"}
    ],
    "must_have_terms": ["胸片浸润影", "白细胞升高", "铁锈色痰", "肺实变体征"],
    "forbidden_terms": ["病毒性肺炎为主", "首选青霉素", "所有患者都需要住院"],
    "scoring_weights": {
      "completeness": 0.35,
      "hallucination": 0.30,
      "schema_compliance": 0.20,
      "relation_quality": 0.15
    }
  },
  {
    "id": "golden_disease_copd_001",
    "title": "慢性阻塞性肺疾病",
    "type": "disease",
    "aliases": ["COPD", "慢阻肺"],
    "source_chunk": {
      "raw_text": "慢性阻塞性肺疾病（COPD）是一种以气流受限为特征的疾病，通常呈进行性发展。吸入支气管舒张剂后 FEV1/FVC < 0.70。临床表现为慢性咳嗽、咳痰、进行性气促。治疗包括长期氧疗、支气管舒张剂、吸入激素。",
      "source": {
        "book": "内科学",
        "edition": "第10版",
        "page": 67,
        "chapter": "呼吸系统疾病"
      }
    },
    "expected_content": {
      "definition": "以气流受限为特征的疾病",
      "clinical_manifestations": "慢性咳嗽、咳痰、进行性气促",
      "diagnostic_criteria": "吸入支气管舒张剂后 FEV1/FVC < 0.70",
      "treatment_principles": "长期氧疗、支气管舒张剂、吸入激素"
    },
    "expected_relations": [
      {"target_name": "呼吸衰竭", "relation_type": "complication"},
      {"target_name": "肺心病", "relation_type": "complication"}
