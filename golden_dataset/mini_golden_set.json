      "schema_compliance": 0.20,
      "relation_quality": 0.15
    }
  },
  {
    "id": "golden_disease_diabetes_001",
    "title": "2型糖尿病",
    "type": "disease",
    "aliases": ["T2DM", "2型糖尿病"],
    "source_chunk": {
      "raw_text": "2型糖尿病是胰岛素抵抗伴胰岛素分泌不足。临床表现为多饮、多尿、多食、体重下降。诊断标准为空腹血糖≥7.0mmol/L或餐后2h血糖≥11.1mmol/L。治疗包括生活方式干预、口服降糖药、胰岛素。",
      "source": {
        "book": "内科学",
        "edition": "第10版",
        "page": 312,
        "chapter": "内分泌系统疾病"
