{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "constants/**/*.ts", "hooks/**/*.ts", "hooks/**/*.tsx", "lib/**/*.ts", "services/**/*.ts", "shared/**/*.ts", "utils/**/*.ts", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["supabase/functions/**", "node_modules"]
}
